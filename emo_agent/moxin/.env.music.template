# 复制本文件为 D:\moxin\.env 并填写

# 认证模式：volc_aksk 或 bearer（默认 volc_aksk）
MUSIC_AUTH_MODE=volc_aksk

# ===== AK/SK 签名模式（推荐，与你当前文档一致）=====
VOLC_ACCESS_KEY_ID=__FILL_AK__
VOLC_SECRET_ACCESS_KEY=__FILL_SK__

MUSIC_API_HOST=open.volcengineapi.com
# 按时长后付费；如购买的是按首套餐，才改为 GenBGM。
MUSIC_API_ACTION=GenBGMForTime
MUSIC_API_VERSION=2024-08-12
MUSIC_API_REGION=cn-beijing
MUSIC_API_SERVICE=imagination

# 可选业务参数
MUSIC_API_TOS_BUCKET=
MUSIC_API_CALLBACK_URL=
MUSIC_API_MODEL_VERSION=v5.0
MUSIC_API_ENABLE_INPUT_REWRITE=false

# 若你想手动覆盖完整提交URL，可填写；留空则脚本自动拼接
MUSIC_API_SUBMIT_URL=
# 查询任务URL（可选）
MUSIC_API_QUERY_URL=

# ===== Bearer 模式（仅当你使用方舟专用API Key时）=====
MUSIC_API_KEY=__FILL_BEARER_KEY_IF_NEEDED__

# ===== 豆包对话 + TTS 朗读（可选）=====
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 新版语音控制台：TTS_API_KEY 与聊天 DOUBAO_API_KEY 是不同凭证。
# 使用新版时填写；使用旧版 App ID / Token 时留空。
TTS_API_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_V3_SPEAKER=zh_female_vv_uranus_bigtts

# 豆包对话：让回复更有灵魂
DOUBAO_API_KEY=__从火山引擎 Ark 控制台获取__
DOUBAO_MODEL_ID=ep-20240619083846-c4xff

# 豆包语音 TTS：文本转语音朗读
TTS_APP_ID=__从豆包语音/语音合成控制台获取__
TTS_TOKEN=__从控制台获取__
TTS_CLUSTER=volcano_tts

# 两种固定音色：V1 接口请用音色列表中的 voice_type，见接入文档
TTS_VOICE_1=zh_female_feiwen_conversation_wvae_bigtts
TTS_VOICE_2=zh_male_M392_conversation_wvae_bigtts
